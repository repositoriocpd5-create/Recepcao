# SME RECEPÇÃO - Variáveis de Ambiente Frontend (Públicas no bundle)
# Configure com a URL e chave anônima/publicável do seu projeto Supabase

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Modo de demonstração / testes offline (true permite testar todos os fluxos com dados simulados em memória se o Supabase não estiver configurado)
VITE_ENABLE_MOCK_FALLBACK=true
